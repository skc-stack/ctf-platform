// -----------------------------------------------------------------------------
// 取得挑戰目錄路徑（根據目前 URL 推算）
// -----------------------------------------------------------------------------
$requestUri = $_SERVER['REQUEST_URI'] ?? '/';
$pathParts = explode('/', trim(parse_url($requestUri, PHP_URL_PATH), '/'));
$slugIndex = array_search('challenge', $pathParts);
$challengeSlug = ($slugIndex !== false && isset($pathParts[$slugIndex + 1])) ? $pathParts[$slugIndex + 1] : '';
$challengeRoot = '/srv/ctf/challenges/' . $challengeSlug;

// -----------------------------------------------------------------------------
// get_flag() - 讀取動態 Flag
// -----------------------------------------------------------------------------
function get_flag(): string {
    global $challengeRoot;
    $flagFile = $challengeRoot . '/.current_flag';
    if (!is_file($flagFile)) {
        return '';
    }
    $content = trim((string)file_get_contents($flagFile));
    return $content;
}

