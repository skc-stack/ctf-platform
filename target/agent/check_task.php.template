    <script>
    document.getElementById('flagForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const btn = document.getElementById('submitBtn');
        const flagInput = this.querySelector('input[name="flag_input"]');
        const result = document.getElementById('result');
        const flag = flagInput.value.trim();

        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass"></i> 傳送中...';

        try {
            // 送到 Target VM 的 local API
            const resp = await fetch('http://127.0.0.1:8787/submit-flag', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    task_id: <?= json_encode($taskId, JSON_UNESCAPED_UNICODE) ?>,
                    flag: flag
                })
            });
            const json = await resp.json();
            const data = json.data || {};

            if (data.correct) {
                result.className = 'success';
                result.innerHTML = '<i class="bi bi-check-circle-fill"></i> 答對了！+' + (data.points_awarded || 0) + ' 分';
                btn.disabled = true;
                btn.innerHTML = '<i class="bi bi-check"></i> 已完成';
            } else {
                result.className = 'error';
                result.innerHTML = '<i class="bi bi-x-circle-fill"></i> ' + (data.reason || 'Flag 不正確');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-flag-fill"></i> 重新送出';
            }
            result.style.display = 'block';
        } catch (e) {
            result.className = 'error';
            result.innerHTML = '<i class="bi bi-x-circle-fill"></i> 提交失敗：' + e;
            result.style.display = 'block';
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-flag-fill"></i> 重新送出';
        }
    });
    </script>
