# CTF Server 環境設定範本
# 複製為 .env 並依實際環境填值（.env 不得 commit）

# === Application ===
APP_NAME="CTF LAB"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Taipei

# 32+ 字元隨機字串，用於 cookie/session/CSRF 加鹽
APP_KEY=change-me-to-32-char-random-string-please

# === Nylas (email sending via grant) ===
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_API_KEY=your-nylas-api-key
NYLAS_GRANT_ID=your-nylas-grant-uuid
NYLAS_FROM_NAME=CTF LAB
NYLAS_FROM_EMAIL=

# === Database ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ctf_server
DB_USERNAME=ctf_server_app
DB_PASSWORD=change-me

# === Session ===
SESSION_NAME=ctf_session
SESSION_LIFETIME=7200

# === Security ===
# 絕對不可放到 Target VM。Flag HMAC 主密鑰。
FLAG_MASTER_SECRET=change-me-to-64-char-random-hex-secret
# Challenge ZIP 套件簽章私鑰（Server 端專屬）
PACKAGE_SIGNING_PRIVATE_KEY_PATH=/var/lib/ctf-server/keys/package-signing.pem

# === Storage ===
STORAGE_CHALLENGE_PATH=/var/lib/ctf-server/challenges
STORAGE_LOG_PATH=/var/log/ctf-server
# 開發期預設 fallback（storage/）
STORAGE_CHALLENGE_FALLBACK=storage/challenges
STORAGE_LOG_FALLBACK=storage/logs

# === Rate Limit (per minute) ===
RATE_LIMIT_LOGIN=5
RATE_LIMIT_ACTIVATION=5
RATE_LIMIT_PASSWORD_RESET=3
RATE_LIMIT_TASK_VALIDATE=10
RATE_LIMIT_FLAG_SUBMIT=10

# === Email tokens (minutes) ===
EMAIL_VERIFICATION_TTL=1440
PASSWORD_RESET_TTL=60

# === Task ===
DEFAULT_TASK_TTL=120
MAX_DEVICES_PER_STUDENT=3
